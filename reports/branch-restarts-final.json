        {
          "name": "Cabin_Deck",
          "expression": "split_part(col(\"Cabin\"), \"/\", 0)",
          "reason": "Extract deck letter from Cabin string to capture spatial location."
        },
        {
          "name": "Cabin_Side",
          "expression": "split_part(col(\"Cabin\"), \"/\", 2)",
          "reason": "Extract side (P/S) from Cabin string to capture orientation."
        },
        {
          "name": "Total_Spending",
          "expression": "col(\"VRDeck\") + col(\"FoodCourt\") + col(\"Spa\") + col(\"RoomService\") + col(\"ShoppingMall\")",
          "reason": "Sum all spending categories to capture total consumption behavior."
        },
        {
          "name": "Cabin_Number",
          "expression": "to_number(split_part(col(\"Cabin\"), \"/\", 1))",
          "reason": "Extract numeric cabin number to capture fine-grained spatial position within a deck."
        },
        {
          "name": "Deck_Spending",
          "expression": "col(\"Total_Spending\") * frequency(col(\"Cabin_Deck\"))",
          "reason": "Interact total spending with deck frequency to capture location-specific consumption patterns."
        }
      ],
