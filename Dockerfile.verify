# Development verification image: installs only the official packages ATLAS uses.
# Build after scripts/package_submission.py; execute the actual flat upload.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-runtime.txt /tmp/requirements-runtime.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-runtime.txt
COPY artifacts/release/ /opt/upload/
WORKDIR /task
ENTRYPOINT ["sh", "-c", "cp /opt/upload/*.py /opt/upload/requirements.txt /task/ && exec python solution.py task.md"]
